# Python
__pycache__/
*.pyc

# Books, audio, and generated output stay local. PDFs are purchased
# copyrighted books and must never be pushed; audio is regenerable.
*.pdf
*.wav
*.mp3
*.flac
*.ogg
*.jpg
app/jobs/
app/voices/
audiobooks/

# Machine-specific config stays local; only config.example.json is tracked.
app/config.json

# Local A/B listen-test material (regenerable, not part of the app).
ab_samples/

# Server console output. The launcher can redirect the server's stdout/stderr
# here; it is machine-local noise, never part of the app.
app/*.log

# ffmpeg fetched at install time by install/bootstrap_ffmpeg.py; not part of
# the source tree, redownloaded per machine.
tools/

# Miniconda installer downloaded transiently by install/bootstrap_conda.py.
install/*.exe

# Compiled installer. OutputDir in AudiobookStudio.iss is ..\Output relative to
# install\, i.e. the repo root -- so without this a rebuild would try to package
# the previous Setup_AudiobookStudio.exe into the new one and fail.
Output/

# Written by setup.py / the one-click installer on the target machine.
install_log.txt
install_warnings.txt
# Written by app/launcher.py when the server fails to start. Under the
# installer there is no console, so this is the only debugging channel.
launcher_log.txt

# Scratch working notes (audit briefs, handoffs). CLAUDE.md is the authoritative
# running log and already carries everything durable from these; keeping the raw
# handoffs too would just be a second copy to go stale and contradict it. These
# got committed and pushed once already before this rule existed; keep the
# pattern broad so the next one does not repeat it.
AUDIT_*.md
HANDOFF_*.md

# Local Claude Code session state and settings, machine-specific.
# .claude/skills/ IS tracked: it carries the project history migrated out of
# CLAUDE.md on 2026-08-04. settings.local.json and *.bak stay local.
.claude/*
!.claude/skills/
